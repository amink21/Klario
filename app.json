{
  "expo": {
    "name": "Klario",
    "slug": "klario",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/bear-favicon.jpg",
    "scheme": "klario",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/bear-favicon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amin123786.klario",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bear-favicon.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/bear-favicon.jpg"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84e621c6-8920-4b19-8266-58062883cd41"
      }
    },
    "owner": "amin123786"
  }
}
